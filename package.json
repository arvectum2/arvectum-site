{
  "name": "arvectum-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/wrangler/bin/wrangler.js pages dev public --port 8788",
    "check": "node scripts/check-repository.mjs && node scripts/check-js.mjs && node scripts/seo-generate-sitemap.mjs --check && node scripts/check-static.mjs && node scripts/check-assets.mjs",
    "check:repo": "node scripts/check-repository.mjs",
    "check:js": "node scripts/check-js.mjs",
    "check:static": "node scripts/check-static.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:seo": "node scripts/seo-generate-sitemap.mjs --check",
    "seo:sitemap": "node scripts/seo-generate-sitemap.mjs",
    "seo:google": "node scripts/seo-google.mjs report",
    "seo:yandex": "node scripts/seo-yandex.mjs report",
    "seo:weekly": "node scripts/seo-weekly-report.mjs",
    "check:production": "node scripts/check-production.mjs",
    "lint:format": "node ./node_modules/prettier/bin/prettier.cjs --check \"public/**/*.{html,css,js}\" README.md",
    "lint:php": "php -l public/api/submit.php && php -l public/api/cookie-consent.php && php -l public/api/health.php",
    "verify": "npm run check && npm run lint:php",
    "lint": "npm run verify"
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
