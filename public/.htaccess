DirectoryIndex index.html
Options -Indexes

<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

<Files ".htaccess">
  Require all denied
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One public origin: HTTPS apex host.
  RewriteCond %{HTTP_HOST} ^www\.arvectum\.com$ [NC]
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ https://arvectum.com/ [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^www\.arvectum\.com$ [NC]
  RewriteRule ^ https://arvectum.com%{REQUEST_URI} [R=301,L,NE]

  # One canonical privacy policy for the company and all Arvectum products.
  RewriteRule ^(?:pushkin-privacy|photo-pod-razmer-privacy)\.html$ /privacy [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+privacy\.html(?:[?\s]) [NC]
  RewriteRule ^privacy\.html$ /privacy [R=301,L,NE]
  RewriteRule ^privacy/?$ privacy.html [L]

  # Consolidate competing commercial landing pages.
  RewriteRule ^solutions/contract-risk-ai-review\.html$ /services/contract-risk-review.html [R=301,L,NE]
  RewriteRule ^solutions/tender-department-ai-agent\.html$ /services/ai-tender-agent.html [R=301,L,NE]

  # Retire legacy URLs previously discovered by search crawlers.
  RewriteRule ^ru/?$ / [R=301,L]
  RewriteRule ^solutions/index\.html$ /solutions.html [R=301,L]
  RewriteRule ^materials/index\.html$ /materials.html [R=301,L]
  RewriteRule ^solutions/(approach|privacy|personal-data-consent|contact|solutions)\.html$ /$1.html [R=301,L,NE]
  RewriteRule ^materials/(cookies|contact|privacy|personal-data-consent|approach|solutions)\.html$ /$1.html [R=301,L,NE]

  # Avoid duplicate root /index.html in search indexes.
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  RewriteRule (^|/)\.env$ - [F,L,NC]
  RewriteRule ^api/storage/ - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
